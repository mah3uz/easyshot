{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyshot-share",
  "main": "src/index.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "routes": [{ "pattern": "share.easyshot.site", "custom_domain": true }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "easyshot-shares" }],
  "durable_objects": { "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }],
  "ratelimits": [{ "name": "BURST", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "IMAGE_MAX_BYTES": "10485760",
    "GIF_MAX_BYTES": "20971520",
    "VIDEO_MAX_BYTES": "209715200",
    "POSTER_MAX_BYTES": "409600",
    "PART_BYTES": "26214400",
    "DAILY_SHARES": "30",
    "DAILY_BYTE_DAYS": "1468006400",
    "STORAGE_STOP_BYTES": "8589934592",
    "INSTALLS_PER_IP_DAY": "5",
    "POW_DIFFICULTY": "20",
    "MIN_APP_VERSION": "0.2.0",
    "MEDIA_ORIGIN": "https://m.easyshot.site",
    "PAGE_ORIGIN": "https://share.easyshot.site"
  }
}

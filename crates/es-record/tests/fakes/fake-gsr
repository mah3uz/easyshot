#!/usr/bin/env python3
import os, signal, socket, sys, threading, time

args = sys.argv[1:]
if "-ipc" not in args:
    if "FAKE_LOG" in os.environ:
        with open(os.environ["FAKE_LOG"], "a") as f:
            f.write("probe " + " ".join(args) + "\n")
    region = args[args.index("-w") + 1]
    monitors = os.environ.get("FAKE_MONITORS", "eDP-1=2560x1600+0+0").split(",")
    sys.stderr.write("gsr error: the region %s doesn't match any monitor. Available monitors and their regions:\n" % region)
    for m in monitors:
        name, rect = m.split("=")
        sys.stderr.write('  "%s"    (%s)\n' % (name, rect))
    sys.exit(51)
modes = os.environ.get("FAKE_MODE", "").split(",")
log_path = os.environ["FAKE_LOG"]


def log(line):
    with open(log_path, "a") as f:
        f.write(line + "\n")


def opt(name):
    return args[args.index(name) + 1]


log("pid %d" % os.getpid())
log("argv " + " ".join(args))
out = opt("-o")
sock_path = opt("-ipc")
done = threading.Event()


def finish(why):
    log("finish " + why)
    with open(out, "w") as f:
        f.write("video")
    print(out, flush=True)
    done.set()


def on_int(*_):
    log("sigint")
    if "ignore_int" not in modes:
        finish("sigint")


def on_usr2(*_):
    log("sigusr2")


signal.signal(signal.SIGINT, on_int)
signal.signal(signal.SIGUSR2, on_usr2)

if "hang_portal" not in modes:
    with open(out + ".ts", "w") as f:
        f.write("monotonic_microsec realtime_microsec\n123456 654321\n")


def serve():
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(sock_path)
    srv.listen(4)
    while True:
        conn, _ = srv.accept()
        data = conn.makefile().readline()
        log("ipc " + data.strip())
        if '"set-paused"' in data:
            if "bad_ipc" in modes:
                conn.sendall(b'{"id":1,"result":"error"}\n')
            else:
                conn.sendall(b'{"id":1,"result":"ok"}\n')
        elif '"stop"' in data and "ignore_ipc_stop" not in modes:
            finish("ipc")
        conn.close()


if "no_ipc" not in modes:
    threading.Thread(target=serve, daemon=True).start()

while not done.is_set():
    time.sleep(0.02)
time.sleep(0.05)

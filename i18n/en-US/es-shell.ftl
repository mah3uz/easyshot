onboarding-check-layer-shell-help = Draws the region selector above every window.
onboarding-check-layer-shell-fix = Your compositor needs wlr-layer-shell. Hyprland, sway and niri have it.
onboarding-check-clipboard = Background clipboard
onboarding-check-clipboard-help = Copies captures without opening a window.
onboarding-check-clipboard-fix = Copying works only while an { -app-name } window has focus. A compositor with ext-data-control or wlr-data-control removes the limit.
onboarding-check-tray = Tray icon
onboarding-check-tray-help = Keeps the { -app-name } menu one click away.
onboarding-check-tray-fix = Start a tray, such as the one in waybar, then reopen { -app-name }.
onboarding-check-recorder = Screen recording
onboarding-check-recorder-help = Records your screen with gpu-screen-recorder.
onboarding-check-recorder-fix = Install gpu-screen-recorder, then reopen { -app-name }.
onboarding-check-ocr = Text recognition
onboarding-check-ocr-help = Copies the text in a capture with tesseract.
onboarding-check-ocr-fix = Install tesseract and a language pack, such as tesseract-data-eng.
onboarding-step-shortcuts-title = Set your shortcuts
onboarding-step-shortcuts-subtitle = Pick keys for the capture commands. You can change them later in Settings.
onboarding-shortcuts-portal = Your desktop asks you to confirm the shortcuts the first time { -app-name } starts.
onboarding-shortcuts-none = Bind the commands in your compositor’s own settings, for example “easyshot capture region”.
onboarding-shortcuts-none-free = No free key
onboarding-shortcuts-use = Use These Shortcuts
onboarding-shortcuts-saved = Saved
onboarding-shortcuts-include = Add one line to your compositor config
onboarding-shortcuts-include-help = { -app-name } keeps your keys in { $file } and never edits your compositor config.

crash-notice-title = { -app-name } stopped unexpectedly
crash-notice-body = A crash report was saved on this computer. It is never sent anywhere.
crash-notice-open = Open crash report

agents-enabled = Let programs use easyshot
agents-enabled-help = Programs you run, such as AI agents, can list your screens and windows and capture them with easyshot agent. Off until you turn it on.
agents-asking = Asking
agents-consent = Ask first
agents-consent-help = Once asks the first time in a session and remembers your answer for as long as you choose.
agents-consent-once = Once
agents-consent-always-ask = Every time
agents-consent-never-ask = Never
agents-grant-until = Allowed until { $time }
agents-grant-session = Allowed until you log out
agents-grant-always = Always allowed
agents-grant-none = Not allowed right now
agents-grant-help = What you chose the last time easyshot asked.
agents-revoke = Revoke
agents-scope = What programs may capture
agents-scope-outputs = Screens
agents-scope-windows = Windows, by app id
agents-scope-footer = Separate names with commas. Leave a field empty to allow every screen or window.
agents-redact = Hide secrets in returned images
agents-redact-help = Covers passwords and keys a program could read in a capture.
agents-log = Recent actions
agents-log-footer = Newest first. The full list is in the easyshot.agent file.
agents-log-empty = No program has used easyshot yet.
agents-log-ok = Done
agents-log-denied = Refused
agents-log-off = Access off
agents-log-pid = Process { $pid }
agents-log-unknown = Unknown
agents-cli-help = Programs ask with easyshot agent; run easyshot agent --help to see what they can do.
